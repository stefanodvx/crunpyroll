// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",

	"runArgs": [
		// https://github.com/89luca89/distrobox/issues/1559 
		// disable selinux isolation that breaks bind mounts
		"--userns=keep-id",
		// disable selinux isolation that breaks bind mounts
		"--security-opt=label=disable"
	],
	// https://github.com/microsoft/vscode-remote-release/issues/7657#issuecomment-1449971698
	// Override podman's default treatment of HOME
	"containerUser": "vscode"
}
